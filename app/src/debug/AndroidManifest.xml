<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: the Device Lab (official plan §14.2). Release builds contain none of this. -->
<!-- RECORD_AUDIO is the one permission the plan allows (§12); M1 moves it to the main manifest. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application>
        <activity
            android:name=".lab.DeviceLabActivity"
            android:exported="true"
            android:label="Apophenia Lab"
            android:taskAffinity="com.betterappmafia.apophenia.lab">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
